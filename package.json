{
  "name": "buryme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BuryMe — peer-to-peer IOU / micro-lending tracker. Monorepo: backend (Express/Node), web (React), shared (generated API types).",
  "scripts": {
    "types:generate": "openapi-typescript contract/openapi.yaml -o shared/src/api-types.gen.ts",
    "types:check": "pnpm --filter shared run typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,yaml,yml,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,yaml,yml,json}\"",
    "dev:backend": "pnpm --filter backend run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter backend run db:generate",
    "db:migrate": "pnpm --filter backend run db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter backend run db:migrate:deploy",
    "db:studio": "pnpm --filter backend run db:studio",
    "db:reset": "pnpm --filter backend run db:reset"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
