{
  "name": "@buryme/backend",
  "private": true,
  "version": "0.1.0",
  "description": "BuryMe Express/Node API. Implements contract/openapi.yaml. All business logic lives here — clients are thin.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=../.env watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@buryme/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^4.21.0",
    "firebase-admin": "^12.5.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "dotenv": "^16.4.5",
    "prisma": "7.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
