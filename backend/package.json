{
  "name": "@buryme/backend",
  "private": true,
  "version": "0.1.0",
  "description": "BuryMe Express/Node API. Implements contract/openapi.yaml. All business logic lives here — clients are thin.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@buryme/shared": "workspace:*",
    "express": "^4.21.0",
    "firebase-admin": "^12.5.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
