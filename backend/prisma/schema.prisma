// BuryMe — Prisma schema.
//
// Scoping convention (per CLAUDE.md's vertical-slice method): models are
// added incrementally, one slice at a time, immediately before that slice's
// backend work begins. Do NOT pre-model entities for slices not yet started
// — contract/openapi.yaml already fully specifies every entity, but this
// schema deliberately lags it slice-by-slice. Each model below carries a
// comment naming the contract/openapi.yaml component schema it maps to, so
// drift between the two is visible at a glance.
//
// Currently scoped through Slice 4 (disbursement): User,
// TelebirrAccount, FcmToken (Slice 1); Request, Obligation (Slice 3);
// Payment (Slice 4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL is NOT set here — Prisma 7 moved datasource.url out of
// schema.prisma. The CLI (generate/migrate/studio) reads it from
// `prisma.config.ts`; the application's PrismaClient reads it via an
// explicit driver adapter in backend/src/db/client.ts.
datasource db {
  provider = "postgresql"
}

// Maps to contract `User` (+ embedded `UserSummary`). `id` is the Firebase
// UID — identity is asserted via the verified bearer token, not stored
// separately. `verificationStatus` on the contract's User schema is
// currently a fixed single-value enum (`Verified`) since unverified users
// don't get a BuryMe profile at all; modeled as a plain String here pending
// that being revisited if it ever needs to vary.
model User {
  id                 String   @id
  identifier         String   @unique
  displayName        String   @map("display_name")
  profilePhotoUrl    String?  @map("profile_photo_url")
  verificationStatus String   @default("Verified") @map("verification_status")
  createdAt          DateTime @default(now()) @map("created_at")

  telebirrAccount TelebirrAccount?
  fcmTokens       FcmToken[]

  initiatedRequests Request[]    @relation("InitiatedRequests")
  receivedRequests  Request[]    @relation("ReceivedRequests")
  borrowerOn        Obligation[] @relation("BorrowerObligations")
  lenderOn          Obligation[] @relation("LenderObligations")
  paymentsMade      Payment[]    @relation("PaymentsMade")
  paymentsReceived  Payment[]    @relation("PaymentsReceived")

  @@map("users")
}

// Maps to contract `TelebirrAccount`, embedded in `User.telebirr`.
model TelebirrAccount {
  accountId          String         @id @default(uuid()) @map("account_id")
  telebirrNumber     String?        @map("telebirr_number")
  verificationStatus TelebirrStatus @default(Unverified) @map("verification_status")
  verifiedAt         DateTime?      @map("verified_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  // Pending OTP challenge (POST /users/me/telebirr/otp). Only a peppered
  // hash of the code is stored; all four are cleared once verified or when
  // the number changes. Internal state — not part of the contract's
  // TelebirrStatus, which stays Unverified until confirmation.
  otpHash      String?   @map("otp_hash")
  otpExpiresAt DateTime? @map("otp_expires_at")
  otpSentAt    DateTime? @map("otp_sent_at")
  otpAttempts  Int       @default(0) @map("otp_attempts")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telebirr_accounts")
}

// Backs `POST /auth/fcm-token` (Slice 1). Not itself a named contract
// schema — device push-token registration is described in prose (§11's FCM
// integration) rather than as a response-body entity. `platform` mirrors
// contract `FcmTokenRequest.platform`'s enum [android, ios, web], kept as a
// plain String here since it's request input, not a domain state machine.
model FcmToken {
  id       String @id @default(uuid())
  token    String @unique
  platform String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("fcm_tokens")
}

// Maps to contract `TelebirrStatus` enum exactly.
enum TelebirrStatus {
  Unverified
  Verified
}

// Maps to contract `Request` (§8.5) — the unified Borrow/Lend/Repayment
// negotiation resource. `proposedSchedule`/`counterProposal` are stored as
// raw JSON matching `ProposedScheduleInput`/`CounterProposalInput`'s shape
// rather than real rows — real Installment rows are Slice 6's job; this is
// just a proposal, not a live schedule. `installmentId` is a plain nullable
// string (Repayment-only) for the same reason — no FK yet.
model Request {
  id                    String              @id @default(uuid())
  requestType           RequestType         @map("request_type")
  amount                Decimal             @db.Decimal(12, 2)
  purpose               String?
  proposedRepaymentType RepaymentType?      @map("proposed_repayment_type")
  proposedSchedule      Json?               @map("proposed_schedule")
  proposedDueDate       DateTime?           @map("proposed_due_date") @db.Date
  disbursementMethod    DisbursementMethod? @map("disbursement_method")
  counterProposal       Json?               @map("counter_proposal")
  installmentId         String?             @map("installment_id")
  note                  String?
  status                RequestStatus       @default(Pending)
  createdAt             DateTime            @default(now()) @map("created_at")
  respondedAt           DateTime?           @map("responded_at")

  initiatingUserId String @map("initiating_user_id")
  initiatingUser   User   @relation("InitiatedRequests", fields: [initiatingUserId], references: [id])

  receivingUserId String @map("receiving_user_id")
  receivingUser   User   @relation("ReceivedRequests", fields: [receivingUserId], references: [id])

  // Null until acceptance for Borrow/Lend; set immediately for Repayment.
  obligationId String?     @map("obligation_id")
  obligation   Obligation? @relation("RequestObligation", fields: [obligationId], references: [id])

  // The Obligation this Request's acceptance created (Borrow/Lend only) —
  // distinct from `obligation` above, which is the Repayment's target.
  createdObligation Obligation? @relation("ObligationOrigin")

  @@map("requests")
}

// Maps to contract `Obligation` (§8.6). `originating_expense_id` has no
// column yet — the serializer hardcodes it to null until Slice 7 (Group
// Expenses) actually creates obligations that way.
model Obligation {
  id                 String             @id @default(uuid())
  principalAmount    Decimal            @map("principal_amount") @db.Decimal(12, 2)
  outstandingBalance Decimal            @map("outstanding_balance") @db.Decimal(12, 2)
  purpose            String
  repaymentType      RepaymentType      @map("repayment_type")
  disbursementMethod DisbursementMethod @map("disbursement_method")
  dueDate            DateTime           @map("due_date") @db.Date
  status             ObligationStatus
  createdAt          DateTime           @default(now()) @map("created_at")
  settledAt          DateTime?          @map("settled_at")

  borrowerId String @map("borrower_id")
  borrower   User   @relation("BorrowerObligations", fields: [borrowerId], references: [id])

  lenderId String @map("lender_id")
  lender   User   @relation("LenderObligations", fields: [lenderId], references: [id])

  // The Borrow/Lend Request whose acceptance created this Obligation.
  originatingRequestId String?  @unique @map("originating_request_id")
  originatingRequest   Request? @relation("ObligationOrigin", fields: [originatingRequestId], references: [id])

  // Repayment Requests targeting this Obligation (obligation_id set at
  // their creation, not on acceptance).
  repaymentRequests Request[] @relation("RequestObligation")

  payments Payment[]

  @@map("obligations")
}

// Maps to contract `RequestType` enum exactly.
enum RequestType {
  Borrow
  Lend
  Repayment
}

// Maps to contract `RequestStatus` enum exactly.
enum RequestStatus {
  Pending
  Countered
  Accepted
  Declined
  Cancelled
}

// Maps to contract `RepaymentType` enum exactly.
enum RepaymentType {
  LumpSum      @map("Lump Sum")
  Installments
}

// Maps to contract `DisbursementMethod` enum exactly.
enum DisbursementMethod {
  AlreadyGiven @map("Already Given")
  ThroughApp   @map("Through App")
}

// Maps to contract `ObligationStatus` enum exactly.
enum ObligationStatus {
  PendingDisbursement @map("Pending Disbursement")
  Active
  PartiallyPaid       @map("Partially Paid")
  Settled
  Disputed
}

// Maps to contract `Payment` (§8.9). One row per money movement on an
// Obligation, in either direction and by either method. Slice 4 creates
// Disbursement/Chapa rows; Slice 5 adds Repayment and External ones.
// `installmentId` stays a plain string until Slice 6 has real rows.
model Payment {
  id                 String           @id @default(uuid())
  amount             Decimal          @db.Decimal(12, 2)
  paymentDirection   PaymentDirection @map("payment_direction")
  paymentMethod      PaymentMethod    @map("payment_method")
  status             PaymentStatus    @default(PendingAcknowledgement)
  installmentId      String?          @map("installment_id")
  recordedByUserId   String?          @map("recorded_by_user_id")
  externalMethodNote String?          @map("external_method_note")
  chapaTransactionId String?          @unique @map("chapa_transaction_id")
  checkoutUrl        String?          @map("checkout_url")
  recordedAt         DateTime         @default(now()) @map("recorded_at")
  confirmedAt        DateTime?        @map("confirmed_at")

  obligationId String     @map("obligation_id")
  obligation   Obligation @relation(fields: [obligationId], references: [id])

  payerId String @map("payer_id")
  payer   User   @relation("PaymentsMade", fields: [payerId], references: [id])

  recipientId String @map("recipient_id")
  recipient   User   @relation("PaymentsReceived", fields: [recipientId], references: [id])

  @@index([obligationId])
  @@map("payments")
}

// Maps to contract `PaymentDirection` enum exactly.
enum PaymentDirection {
  Disbursement
  Repayment
}

// Maps to contract `PaymentMethod` enum exactly.
enum PaymentMethod {
  Chapa
  External
}

// Maps to contract `PaymentStatus` enum exactly.
enum PaymentStatus {
  PendingAcknowledgement @map("Pending Acknowledgement")
  Confirmed
  Disputed
  Failed
}
