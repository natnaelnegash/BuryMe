// BuryMe — Prisma schema.
//
// Scoping convention (per CLAUDE.md's vertical-slice method): models are
// added incrementally, one slice at a time, immediately before that slice's
// backend work begins. Do NOT pre-model entities for slices not yet started
// — contract/openapi.yaml already fully specifies every entity, but this
// schema deliberately lags it slice-by-slice. Each model below carries a
// comment naming the contract/openapi.yaml component schema it maps to, so
// drift between the two is visible at a glance.
//
// Currently scoped through Slice 9 (notifications): User, TelebirrAccount,
// FcmToken (Slice 1); Request, Obligation (Slice 3); Payment (Slice 4);
// RepaymentSchedule, Installment (Slice 6); GroupExpense,
// GroupExpenseParticipant (Slice 7); SettlementSuggestion (Slice 8);
// Notification (Slice 9).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL is NOT set here — Prisma 7 moved datasource.url out of
// schema.prisma. The CLI (generate/migrate/studio) reads it from
// `prisma.config.ts`; the application's PrismaClient reads it via an
// explicit driver adapter in backend/src/db/client.ts.
datasource db {
  provider = "postgresql"
}

// Maps to contract `User` (+ embedded `UserSummary`). `id` is the Firebase
// UID — identity is asserted via the verified bearer token, not stored
// separately. `verificationStatus` on the contract's User schema is
// currently a fixed single-value enum (`Verified`) since unverified users
// don't get a BuryMe profile at all; modeled as a plain String here pending
// that being revisited if it ever needs to vary.
model User {
  id                 String   @id
  identifier         String   @unique
  displayName        String   @map("display_name")
  profilePhotoUrl    String?  @map("profile_photo_url")
  verificationStatus String   @default("Verified") @map("verification_status")
  createdAt          DateTime @default(now()) @map("created_at")

  // Contract `NotificationPreferences` (§7.1.5) — one switch per §13.2
  // event family, matching the seven rows of the preferences screen
  // (66:744). Push delivery only: the feed row is always written.
  // Default on, except the two the design ships off.
  prefRequests      Boolean @default(true) @map("pref_requests")
  prefGroupExpenses Boolean @default(false) @map("pref_group_expenses")
  prefPayments      Boolean @default(true) @map("pref_payments")
  prefSchedules     Boolean @default(true) @map("pref_schedules")
  prefSettlements   Boolean @default(true) @map("pref_settlements")
  prefReminders     Boolean @default(false) @map("pref_reminders")
  prefTelebirr      Boolean @default(true) @map("pref_telebirr")

  telebirrAccount TelebirrAccount?
  fcmTokens       FcmToken[]

  initiatedRequests Request[]    @relation("InitiatedRequests")
  receivedRequests  Request[]    @relation("ReceivedRequests")
  borrowerOn        Obligation[] @relation("BorrowerObligations")
  lenderOn          Obligation[] @relation("LenderObligations")
  paymentsMade      Payment[]    @relation("PaymentsMade")
  paymentsReceived  Payment[]    @relation("PaymentsReceived")
  expensesPaid      GroupExpense[]            @relation("ExpensesPaid")
  expenseShares     GroupExpenseParticipant[] @relation("ExpenseShares")

  settlementsAsA     SettlementSuggestion[] @relation("SettlementsAsA")
  settlementsAsB     SettlementSuggestion[] @relation("SettlementsAsB")
  settlementsToPay   SettlementSuggestion[] @relation("SettlementNetPayer")
  settlementsToReceive SettlementSuggestion[] @relation("SettlementNetRecipient")

  notifications Notification[] @relation("UserNotifications")

  @@map("users")
}

// Maps to contract `TelebirrAccount`, embedded in `User.telebirr`.
model TelebirrAccount {
  accountId          String         @id @default(uuid()) @map("account_id")
  telebirrNumber     String?        @map("telebirr_number")
  verificationStatus TelebirrStatus @default(Unverified) @map("verification_status")
  verifiedAt         DateTime?      @map("verified_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  // Pending OTP challenge (POST /users/me/telebirr/otp). Only a peppered
  // hash of the code is stored; all four are cleared once verified or when
  // the number changes. Internal state — not part of the contract's
  // TelebirrStatus, which stays Unverified until confirmation.
  otpHash      String?   @map("otp_hash")
  otpExpiresAt DateTime? @map("otp_expires_at")
  otpSentAt    DateTime? @map("otp_sent_at")
  otpAttempts  Int       @default(0) @map("otp_attempts")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telebirr_accounts")
}

// Backs `POST /auth/fcm-token` (Slice 1). Not itself a named contract
// schema — device push-token registration is described in prose (§11's FCM
// integration) rather than as a response-body entity. `platform` mirrors
// contract `FcmTokenRequest.platform`'s enum [android, ios, web], kept as a
// plain String here since it's request input, not a domain state machine.
model FcmToken {
  id       String @id @default(uuid())
  token    String @unique
  platform String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("fcm_tokens")
}

// Maps to contract `TelebirrStatus` enum exactly.
enum TelebirrStatus {
  Unverified
  Verified
}

// Maps to contract `Request` (§8.5) — the unified Borrow/Lend/Repayment
// negotiation resource. `proposedSchedule`/`counterProposal` are stored as
// raw JSON matching `ProposedScheduleInput`/`CounterProposalInput`'s shape
// rather than real rows — real Installment rows are Slice 6's job; this is
// just a proposal, not a live schedule. `installmentId` is a plain nullable
// string (Repayment-only) for the same reason — no FK yet.
model Request {
  id                    String              @id @default(uuid())
  requestType           RequestType         @map("request_type")
  amount                Decimal             @db.Decimal(12, 2)
  purpose               String?
  proposedRepaymentType RepaymentType?      @map("proposed_repayment_type")
  proposedSchedule      Json?               @map("proposed_schedule")
  proposedDueDate       DateTime?           @map("proposed_due_date") @db.Date
  disbursementMethod    DisbursementMethod? @map("disbursement_method")
  counterProposal       Json?               @map("counter_proposal")
  installmentId         String?             @map("installment_id")
  note                  String?
  status                RequestStatus       @default(Pending)
  createdAt             DateTime            @default(now()) @map("created_at")
  respondedAt           DateTime?           @map("responded_at")

  initiatingUserId String @map("initiating_user_id")
  initiatingUser   User   @relation("InitiatedRequests", fields: [initiatingUserId], references: [id])

  receivingUserId String @map("receiving_user_id")
  receivingUser   User   @relation("ReceivedRequests", fields: [receivingUserId], references: [id])

  // Null until acceptance for Borrow/Lend; set immediately for Repayment.
  obligationId String?     @map("obligation_id")
  obligation   Obligation? @relation("RequestObligation", fields: [obligationId], references: [id])

  // The Obligation this Request's acceptance created (Borrow/Lend only) —
  // distinct from `obligation` above, which is the Repayment's target.
  createdObligation Obligation? @relation("ObligationOrigin")

  @@map("requests")
}

// Maps to contract `Obligation` (§8.6). Created either by accepting a
// Borrow/Lend Request or by a group expense (`originatingExpenseId`).
model Obligation {
  id                 String             @id @default(uuid())
  principalAmount    Decimal            @map("principal_amount") @db.Decimal(12, 2)
  outstandingBalance Decimal            @map("outstanding_balance") @db.Decimal(12, 2)
  purpose            String
  repaymentType      RepaymentType      @map("repayment_type")
  disbursementMethod DisbursementMethod @map("disbursement_method")
  dueDate            DateTime           @map("due_date") @db.Date
  status             ObligationStatus
  createdAt          DateTime           @default(now()) @map("created_at")
  settledAt          DateTime?          @map("settled_at")

  borrowerId String @map("borrower_id")
  borrower   User   @relation("BorrowerObligations", fields: [borrowerId], references: [id])

  lenderId String @map("lender_id")
  lender   User   @relation("LenderObligations", fields: [lenderId], references: [id])

  // The Borrow/Lend Request whose acceptance created this Obligation.
  originatingRequestId String?  @unique @map("originating_request_id")
  originatingRequest   Request? @relation("ObligationOrigin", fields: [originatingRequestId], references: [id])

  // Repayment Requests targeting this Obligation (obligation_id set at
  // their creation, not on acceptance).
  repaymentRequests Request[] @relation("RequestObligation")

  payments Payment[]
  schedule RepaymentSchedule?

  // Set when this obligation was spawned by a group expense (Slice 7).
  originatingExpenseId String?                  @unique @map("originating_expense_id")
  originatingExpense   GroupExpenseParticipant? @relation(fields: [originatingExpenseId], references: [id])

  // Settlement suggestions this obligation is one half of (Slice 8). Not
  // unique: a declined suggestion leaves the obligation free to be paired
  // again.
  settlementsAsA SettlementSuggestion[] @relation("SettlementObligationA")
  settlementsAsB SettlementSuggestion[] @relation("SettlementObligationB")

  @@map("obligations")
}

// Maps to contract `RequestType` enum exactly.
enum RequestType {
  Borrow
  Lend
  Repayment
}

// Maps to contract `RequestStatus` enum exactly.
enum RequestStatus {
  Pending
  Countered
  Accepted
  Declined
  Cancelled
}

// Maps to contract `RepaymentType` enum exactly.
enum RepaymentType {
  LumpSum      @map("Lump Sum")
  Installments
}

// Maps to contract `DisbursementMethod` enum exactly.
enum DisbursementMethod {
  AlreadyGiven @map("Already Given")
  ThroughApp   @map("Through App")
}

// Maps to contract `ObligationStatus` enum exactly.
enum ObligationStatus {
  PendingDisbursement @map("Pending Disbursement")
  Active
  PartiallyPaid       @map("Partially Paid")
  Settled
  Disputed
}

// Maps to contract `Payment` (§8.9). One row per money movement on an
// Obligation, in either direction and by either method. Slice 4 creates
// Disbursement/Chapa rows; Slice 5 adds Repayment and External ones.
// `installmentId` points at the Installment a repayment settles (Installments
// obligations only).
model Payment {
  id                 String           @id @default(uuid())
  amount             Decimal          @db.Decimal(12, 2)
  paymentDirection   PaymentDirection @map("payment_direction")
  paymentMethod      PaymentMethod    @map("payment_method")
  status             PaymentStatus    @default(PendingAcknowledgement)
  installmentId      String?          @map("installment_id")
  installment        Installment?     @relation(fields: [installmentId], references: [id])
  recordedByUserId   String?          @map("recorded_by_user_id")
  externalMethodNote String?          @map("external_method_note")
  chapaTransactionId String?          @unique @map("chapa_transaction_id")
  checkoutUrl        String?          @map("checkout_url")
  recordedAt         DateTime         @default(now()) @map("recorded_at")
  confirmedAt        DateTime?        @map("confirmed_at")

  obligationId String     @map("obligation_id")
  obligation   Obligation @relation(fields: [obligationId], references: [id])

  payerId String @map("payer_id")
  payer   User   @relation("PaymentsMade", fields: [payerId], references: [id])

  recipientId String @map("recipient_id")
  recipient   User   @relation("PaymentsReceived", fields: [recipientId], references: [id])

  @@index([obligationId])
  @@map("payments")
}

// Maps to contract `PaymentDirection` enum exactly.
enum PaymentDirection {
  Disbursement
  Repayment
}

// Maps to contract `PaymentMethod` enum exactly.
enum PaymentMethod {
  Chapa
  External
}

// Maps to contract `PaymentStatus` enum exactly.
enum PaymentStatus {
  PendingAcknowledgement @map("Pending Acknowledgement")
  Confirmed
  Disputed
  Failed
}

// Maps to contract `RepaymentSchedule` (§8.7). Fixed at agreement and
// read-only thereafter (§6.3.2): created inside the accept transaction
// from the agreed `proposed_schedule`, one per Installments obligation.
model RepaymentSchedule {
  id               String         @id @default(uuid())
  installmentCount Int            @map("installment_count")
  status           ScheduleStatus @default(Active)
  createdAt        DateTime       @default(now()) @map("created_at")

  obligationId String     @unique @map("obligation_id")
  obligation   Obligation @relation(fields: [obligationId], references: [id])

  installments Installment[]

  @@map("repayment_schedules")
}

// Maps to contract `Installment` (§8.8). `Pending → Overdue` is applied
// lazily when a schedule is read or paid against (lib/schedule.ts) —
// there is no scheduler in the stack yet (reminders are Slice 9).
model Installment {
  id      String            @id @default(uuid())
  amount  Decimal           @db.Decimal(12, 2)
  dueDate DateTime          @map("due_date") @db.Date
  status  InstallmentStatus @default(Pending)
  paidAt  DateTime?         @map("paid_at")

  scheduleId String            @map("schedule_id")
  schedule   RepaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  payments Payment[]

  @@index([scheduleId])
  @@map("installments")
}

// Maps to contract `ScheduleStatus` enum exactly.
enum ScheduleStatus {
  Active
  Completed
}

// Maps to contract `InstallmentStatus` enum exactly.
enum InstallmentStatus {
  Pending
  Paid
  Overdue
}

// Maps to contract `GroupExpense` (§8.12). One payer records a shared bill
// and assigns each participant a share; accepting is not a thing here —
// the obligations are created immediately, since the payer has already
// settled the bill outside the platform.
model GroupExpense {
  id                 String   @id @default(uuid())
  totalAmount        Decimal  @map("total_amount") @db.Decimal(12, 2)
  description        String
  expenseDate        DateTime @map("expense_date") @db.Date
  // Carried onto every spawned obligation as its due date.
  dueDate            DateTime @map("due_date") @db.Date
  payerShareIncluded Boolean  @map("payer_share_included")
  // Recorded for accounting completeness only — never spawns an obligation.
  payerShareAmount   Decimal? @map("payer_share_amount") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  payerId String @map("payer_id")
  payer   User   @relation("ExpensesPaid", fields: [payerId], references: [id])

  participants GroupExpenseParticipant[]

  @@map("group_expenses")
}

// Maps to contract `GroupExpenseParticipant` (§8.13) — one row per
// participant, paired 1:1 with the Obligation it spawned.
model GroupExpenseParticipant {
  id             String  @id @default(uuid())
  assignedAmount Decimal @map("assigned_amount") @db.Decimal(12, 2)

  expenseId String       @map("expense_id")
  expense   GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  participantId String @map("participant_id")
  participant   User   @relation("ExpenseShares", fields: [participantId], references: [id])

  // The bilateral obligation this share created (payer = lender).
  obligation Obligation?

  @@unique([expenseId, participantId])
  @@index([expenseId])
  @@map("group_expense_participants")
}

// Maps to contract `SettlementSuggestion` (§8.14) — a proposal to net two
// reciprocal obligations against each other. `userA` is always the
// initiator, so `obligationA` is the obligation the initiator borrows on,
// matching the contract's description of `obligation_id_a`. Both parties
// must accept before either obligation settles; the pair is only recorded
// here, no money moves through the platform.
model SettlementSuggestion {
  id        String    @id @default(uuid())
  netAmount Decimal   @map("net_amount") @db.Decimal(12, 2)
  createdAt DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  userAId String @map("user_a_id")
  userA   User   @relation("SettlementsAsA", fields: [userAId], references: [id])

  userBId String @map("user_b_id")
  userB   User   @relation("SettlementsAsB", fields: [userBId], references: [id])

  // The obligation each party borrows on — A owes on obligationA.
  obligationAId String     @map("obligation_a_id")
  obligationA   Obligation @relation("SettlementObligationA", fields: [obligationAId], references: [id])

  obligationBId String     @map("obligation_b_id")
  obligationB   Obligation @relation("SettlementObligationB", fields: [obligationBId], references: [id])

  // Whoever owes more after netting, and who receives the difference.
  netPayerId String @map("net_payer_id")
  netPayer   User   @relation("SettlementNetPayer", fields: [netPayerId], references: [id])

  netRecipientId String @map("net_recipient_id")
  netRecipient   User   @relation("SettlementNetRecipient", fields: [netRecipientId], references: [id])

  userAResponse SettlementResponse @default(Pending) @map("user_a_response")
  userBResponse SettlementResponse @default(Pending) @map("user_b_response")
  status        SettlementResponse @default(Pending)

  @@index([userAId])
  @@index([userBId])
  @@map("settlement_suggestions")
}

// Maps to contract `SettlementResponse` enum exactly.
enum SettlementResponse {
  Pending
  Accepted
  Declined
}

// Maps to contract `Notification` (§8.11). `title` and `body` are rendered
// from the §13.2 catalog when the event fires and stored here, so the feed,
// the Flutter app and the FCM push payload all read identical copy.
// `notificationType` holds the catalog's event id (e.g. "BSS-02"); it is a
// plain String rather than a Prisma enum because the ids contain hyphens,
// which Prisma enum members can't express, and the contract's
// NotificationType enum is the authority.
model Notification {
  id               String    @id @default(uuid())
  notificationType String    @map("notification_type")
  title            String
  body             String
  isRead           Boolean   @default(false) @map("is_read")
  deliveredAt      DateTime? @map("delivered_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // What to open when tapped. Null for the catalog's Dashboard-targeted
  // events, so these aren't foreign keys — the referenced row may also be
  // one the recipient can no longer see.
  referenceId   String? @map("reference_id")
  referenceType String? @map("reference_type")

  // Set only by the timed reminders (§13.3), which re-evaluate the same
  // rows on every sweep. The unique index is what stops a reminder being
  // sent twice — event-driven notifications leave it null, since they fire
  // from a state change that happens once.
  dedupeKey String? @unique @map("dedupe_key")

  // The feed is read newest-first, scoped to one user.
  @@index([userId, createdAt])
  @@map("notifications")
}
