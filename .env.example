# Copy to .env and fill in. Never commit the real .env.

# --- Backend ---
PORT=4000
DATABASE_URL=postgresql://buryme:buryme_dev@localhost:5433/buryme

# Firebase Admin SDK (server-side token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Chapa
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# Web app origin Chapa's hosted checkout returns the payer to after paying.
WEB_ORIGIN=http://localhost:5173
# Public origin of this API (e.g. an ngrok/cloudflared tunnel in dev). Used
# for Chapa's per-transaction callback_url; register
# <origin>/api/v1/webhooks/chapa as the single webhook URL in the dashboard.
API_PUBLIC_ORIGIN=

# --- Web (Vite exposes only VITE_-prefixed vars to the client) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_BASE_URL=http://localhost:4000/api/v1

# AfroMessage (Telebirr OTP SMS). Leave blank in dev: codes are logged to the
# backend console instead. AFROMESSAGE_FROM is the identifier id from the
# AfroMessage dashboard; no sender name is needed.
AFROMESSAGE_API_KEY=
AFROMESSAGE_FROM=
# Secret mixed into stored OTP hashes. Any long random string; required in
# production, defaults to a fixed dev value otherwise.
OTP_PEPPER=
